# pm25-auth configuration (ARCHITECTURE.md of pm25-platform, section 7).
# Copy to .env for a run outside Docker; never commit real secrets.

HTTP_ADDR=:8001
DATABASE_URL=postgres://pm25_auth:pm25_auth_dev@localhost:5432/pm25?sslmode=disable
DB_MAX_CONNS=3

# Generate with: go run ./cmd/pm25-auth signing-key generate
# Empty JWT_SIGNING_KEY = random development key, lost at every restart.
JWT_SIGNING_KEY=
JWT_SIGNING_KID=
# Earlier public keys still accepted during a rotation: kid:base64,kid:base64
JWT_PREVIOUS_PUBLIC_KEYS=
JWT_ISSUER=http://localhost:8001
JWT_AUDIENCE=pm25-api
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=168h

CORS_ORIGINS=http://localhost:4200

# Per client IP, on every route except /health and the JWKS
RATE_LIMIT_RPS=2
RATE_LIMIT_BURST=10
# true behind the alwaysdata proxy: the client IP is read from X-Forwarded-For
TRUST_PROXY=false

LOG_LEVEL=info
